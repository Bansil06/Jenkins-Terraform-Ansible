pipeline {
    agent any

    environment {
        AWS_ACCESS_KEY_ID     = credentials('aws-creds')
        AWS_SECRET_ACCESS_KEY = credentials('aws-creds')
        AWS_DEFAULT_REGION    = 'ap-south-1'

        GITHUB_CREDS = credentials('github-creds')
    }

    stages {

        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init') {
            steps {
                sh 'terraform init'
            }
        }

        stage('Terraform Apply') {
            steps {
                sh '''
                  terraform apply -auto-approve \
                    -var="key_name=key"
                '''
            }
        }

stage('Commit static_inventory file into github') {
    steps {
        withCredentials([usernamePassword(
            credentialsId: 'github-creds',
            usernameVariable: 'GIT_USER',
            passwordVariable: 'GIT_TOKEN'
        )]) {
            sh '''
              git config user.email "patelbansi@gmail.com"
              git config user.name "Bansil06"
              git add static_inventory || true
              git commit -m "static_inventory added by Jenkins" || true
              git push https://${GIT_USER}:${GIT_TOKEN}@github.com/Bansil06/Jenkins-Terraform-Ansible.git HEAD:main
            '''
        }
    }
}


        stage('Ansible - Install Docker on remote hosts') {
            agent { label 'ansible' }
            steps {
                ansiblePlaybook(
                    credentialsId: 'ec2-ssh-key',
                    disableHostKeyChecking: true,
                    installation: 'ansible',
                    inventory: 'static_inventory',
                    playbook: 'docker_installation_playbook.yaml'
                )
            }
        }
    }

    post {
        success {
            echo "Instance ready and configuration completed"
        }
        failure {
            echo "Pipeline failed. Check logs above."
        }
    }
}
