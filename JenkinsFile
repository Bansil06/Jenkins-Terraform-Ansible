pipeline {
    agent any

    environment {
        AWS_ACCESS_KEY_ID     = credentials('aws-creds')
        AWS_SECRET_ACCESS_KEY = credentials('aws-creds')
        AWS_DEFAULT_REGION    = 'ap-south-1'
    }

    stages {

        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init') {
            steps {
                sh 'terraform init'
            }
        }

        stage('Terraform Apply') {
            steps {
                sh 'terraform apply -auto-approve -var="key_name=key"'
            }
        }

stage('Commit static_inventory file into GitHub') {
    steps {
        withCredentials([string(credentialsId: 'github-pat', variable: 'GIT_TOKEN')]) {
            sh '''
              # Ensure we are on main branch without overwriting files
              git fetch origin main
              git checkout -B main

              git config user.email "patelbansi@gmail.com"
              git config user.name "Bansil06"

              # Add and commit static_inventory if it exists
              if [ -f static_inventory ]; then
                  git add static_inventory
                  git diff-index --quiet HEAD || git commit -m "static_inventory added by Jenkins"
                  git push https://:${GIT_TOKEN}@github.com/Bansil06/Jenkins-Terraform-Ansible.git main
              else
                  echo "static_inventory file not found, skipping commit"
              fi
            '''
        }
    }
}


        stage('Ansible - Install Docker on remote hosts') {
            steps {
                ansiblePlaybook(
                    credentialsId: 'ec2-ssh-key',
                    disableHostKeyChecking: true,
                    installation: 'ansible',
                    inventory: 'static_inventory',
                    playbook: 'docker_installation_playbook.yaml'
                )
            }
        }
    }

    post {
        success {
            echo "Instance ready and configuration completed"
        }
        failure {
            echo "Pipeline failed. Check logs above."
        }
    }
}
