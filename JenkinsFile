pipeline {
    agent any

    environment {
        AWS_ACCESS_KEY_ID     = credentials('aws-creds')
        AWS_SECRET_ACCESS_KEY = credentials('aws-creds')
        AWS_DEFAULT_REGION    = 'ap-south-1'

        GITHUB_CREDS = credentials('github-creds')
    }

    stages {

        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init') {
            steps {
                sh 'terraform init'
            }
        }

        stage('Terraform Apply') {
            steps {
                sh '''
                  terraform apply -auto-approve \
                    -var="key_name=key"
                '''
            }
        }

        stage('Commit static_inventory file into github') {
            steps {
                sh '''
                  git status
                  git config user.email "shamimice03@gmail.com"
                  git config user.name "shamim"
                  git add .
                  git commit -m "static_inventory file added by Jenkins Pipeline" || true
                  git push https://${GITHUB_CREDS_USR}:${GITHUB_CREDS_PSW}@github.com/${GITHUB_CREDS_USR}/jenkins-terraform-ansible.git HEAD:main
                '''
            }
        }

        stage('Ansible - Install Docker on remote hosts') {
            agent { label 'ansible' }
            steps {
                ansiblePlaybook(
                    credentialsId: 'ec2-ssh-key',
                    disableHostKeyChecking: true,
                    installation: 'ansible',
                    inventory: 'static_inventory',
                    playbook: 'docker_installation_playbook.yaml'
                )
            }
        }
    }

    post {
        success {
            echo "Instance ready and configuration completed"
        }
        failure {
            echo "Pipeline failed. Check logs above."
        }
    }
}
